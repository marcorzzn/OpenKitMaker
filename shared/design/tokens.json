{
  "$schema": "https://openkitmaker.dev/schemas/design-tokens-v1.json",
  "name": "OpenKitMaker Design System Tokens",
  "version": "1.0.0",
  "color": {
    "primary": "#0F52BA",
    "primaryVariant": "#0A387E",
    "secondary": "#00C49F",
    "secondaryVariant": "#009E7E",
    "background": "#0F141C",
    "surface": "#1A2230",
    "surfaceElevated": "#253146",
    "surfaceBorder": "#2E3D56",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#94A3B8",
    "textTertiary": "#64748B",
    "error": "#EF4444",
    "success": "#10B981",
    "warning": "#F59E0B",
    "accent": "#FFB800"
  },
  "spacing": {
    "xxs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "xxl": "32px",
    "xxxl": "48px"
  },
  "radii": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "typography": {
    "fontFamily": "Inter, Roboto, system-ui, -apple-system, sans-serif",
    "fontSize": {
      "xs": "11px",
      "sm": "13px",
      "base": "15px",
      "md": "17px",
      "lg": "20px",
      "xl": "24px",
      "xxl": "32px"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "motion": {
    "durationFast": "150ms",
    "durationNormal": "250ms",
    "durationSlow": "400ms",
    "easingStandard": "cubic-bezier(0.4, 0.0, 0.2, 1)",
    "easingDecelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
    "easingAccelerate": "cubic-bezier(0.4, 0.0, 1, 1)"
  },
  "lighting": {
    "studio": {
      "intensity": 1.2,
      "colorTemp": 6500,
      "shadowSoftness": 0.5
    },
    "stadium": {
      "intensity": 1.8,
      "colorTemp": 5400,
      "shadowSoftness": 0.2
    }
  },
  "elevation": {
    "level0": "0px 0px 0px rgba(0,0,0,0)",
    "level1": "0px 2px 8px rgba(0,0,0,0.32)",
    "level2": "0px 6px 18px rgba(0,0,0,0.48)",
    "level3": "0px 12px 32px rgba(0,0,0,0.64)"
  },
  "layout": {
    "topBarHeight": "64px",
    "bottomBarHeight": "64px",
    "cardPadding": "16px",
    "maxContentWidth": "1280px"
  }
}

